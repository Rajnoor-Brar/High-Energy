{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Rajnoor-Brar/High-Energy/hekit/plan/spec_v2.json",
  "title": "hekit resolved spec (schema 2)",
  "description": "The contract between hep (Python) and hep-run (C++): one file per event group. Everything is explicit; hep-run validates only structure (03 §7).",
  "type": "object",
  "required": ["meta", "run", "source", "output", "status"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["schema", "point", "hash"],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": 2},
        "point": {"type": "string", "minLength": 1},
        "aliases": {"type": "array", "items": {"type": "string"}},
        "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "origin": {"type": "string"}
      }
    },
    "run": {
      "type": "object",
      "required": ["events", "seed", "threads", "seeds"],
      "additionalProperties": false,
      "properties": {
        "events": {"type": "integer", "minimum": 0},
        "seed": {"type": "integer", "minimum": 1, "maximum": 900000000},
        "threads": {"type": "integer", "minimum": 0, "maximum": 4096},
        "seeds": {
          "type": "object",
          "required": ["point", "instances"],
          "additionalProperties": false,
          "properties": {
            "point": {"type": "integer", "minimum": 1, "maximum": 900000000},
            "instances": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "integer", "minimum": 1, "maximum": 900000000}
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["pythia", "store", "stream"]},
        "cards": {"type": "array", "items": {"type": "string"}},
        "input": {"type": "string"},
        "inputs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "output": {
      "type": "object",
      "required": ["dir", "yoda", "summary"],
      "additionalProperties": false,
      "properties": {
        "dir": {"type": "string", "minLength": 1},
        "yoda": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "sink": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": {"enum": ["rivet", "module", "store", "delphes"]},
          "analyses": {"type": "array", "items": {"type": "string"}},
          "paths": {"type": "array", "items": {"type": "string"}},
          "xsec": {"type": ["string", "number"]},
          "weights": {"enum": ["nominal", "all"]},
          "dump_every": {"type": "integer", "minimum": 0},
          "check_beams": {"type": "boolean"},
          "name": {"type": "string"},
          "library": {"type": "string"},
          "options": {"type": "object"},
          "dir": {"type": "string"},
          "compression": {"enum": ["gz", "zst", "none"]},
          "card": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "status": {
      "type": "object",
      "required": ["fd", "heartbeat_ms"],
      "additionalProperties": false,
      "properties": {
        "fd": {"type": "integer", "minimum": 1},
        "heartbeat_ms": {"type": "integer", "minimum": 1}
      }
    }
  }
}
