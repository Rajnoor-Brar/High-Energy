# hekit house style (07 §4), translated from the legacy ROOT presets rather than invented:
# `legacy/configs/defaults/Paint.toml` [paint.default.canvas]/[.axis] and `saveHist.C`'s gStyle calls.
#
#   canvas 900x600 px          -> figure 9 x 6 in at 100 dpi
#   margins 0.12/0.05/0.12/0.08 -> the subplot margins below, in the same order
#   ticks_x = ticks_y = true    -> ticks on all four sides, pointing in (ROOT's default look)
#   grid off, title border 0    -> no grid, no frame around the legend
#   font 43 (Helvetica, size in px) -> a sans stack; sizes scaled to points
#
# Anything a `.plot` file says overrides this: the style decides how a figure looks, the `.plot` file
# decides what it says.

figure.figsize:      9, 6
figure.dpi:          100
savefig.dpi:         200
savefig.bbox:        tight
savefig.pad_inches:  0.05

figure.subplot.left:   0.12
figure.subplot.right:  0.95
figure.subplot.bottom: 0.12
figure.subplot.top:    0.92

font.family:      sans-serif
font.sans-serif:  DejaVu Sans, Helvetica, Arial, Liberation Sans
font.size:        13
axes.titlesize:   16
axes.labelsize:   15
xtick.labelsize:  13
ytick.labelsize:  13
legend.fontsize:  12

axes.linewidth:   1.0
axes.grid:        False
axes.formatter.limits: -3, 4
axes.formatter.use_mathtext: True
# Colour-blind safe (Okabe-Ito-ish). No '#': in a style file everything after it is a comment.
axes.prop_cycle:  cycler('color', ['0173b2', 'de8f05', '029e73', 'cc78bc', 'ca9161', '949494', 'd55e00', '56b4e9'])

lines.linewidth:  1.6
lines.markersize: 4.5
errorbar.capsize: 0

xtick.direction:  in
ytick.direction:  in
xtick.top:        True
ytick.right:      True
xtick.minor.visible: True
ytick.minor.visible: True
xtick.major.size: 6
ytick.major.size: 6
xtick.minor.size: 3
ytick.minor.size: 3

legend.frameon:      False
legend.handlelength: 1.6
legend.columnspacing: 1.2
legend.labelspacing: 0.35
